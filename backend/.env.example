# ============================================================================
# Safety AI Agent - 환경변수 설정 예시
# ============================================================================
#
# 사용법:
#   1. 이 파일을 .env로 복사: cp .env.example .env
#   2. 실제 API 키 값으로 수정
#   3. .env 파일은 .gitignore에 포함되어 있어 Git에 커밋되지 않습니다
#
# ============================================================================

# ============================================================================
# 필수 환경변수
# ============================================================================

# Anthropic Claude API 키 (필수)
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenAI API 키 (필수 - RAG 임베딩용)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# 한국산업안전보건공단 API 키 (필수 - 법령 데이터 수집용)
# 발급: https://www.data.go.kr/
KOSHA_API_KEY=your-kosha-api-key-here

# ============================================================================
# 선택적 환경변수
# ============================================================================

# 로그 레벨 (기본값: INFO)
# 옵션: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 로그 파일 경로 (기본값: None - 콘솔만 출력)
# 설정하지 않으면 콘솔에만 출력됩니다
LOG_FILE=logs/app.log

# ============================================================================
# 참고사항
# ============================================================================
#
# 1. 모든 API 키는 실제 값으로 교체해야 합니다
# 2. .env 파일은 절대 Git에 커밋하지 마세요
# 3. 프로덕션 환경에서는 환경변수 관리 시스템을 사용하세요
# 4. API 키는 정기적으로 로테이션하는 것을 권장합니다
#
# ============================================================================
